{
  "name": "dsh-memjudge",
  "version": "0.1.2",
  "description": "DeepSeek Harness v2 自进化长效记忆引擎：Schema v8 多空间隔离 + 双边闭合轮异步脱水 + 三路 RRF 混合检索 + O(log N) 槽位证据门 + 保 KV Cache 两段式动态注入 + L0-L3 热冷代谢与增量 Wiki 编译。",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client.js",
    "./store": "./src/store.mjs",
    "./search": "./src/search.mjs",
    "./judge": "./src/judge.mjs",
    "./layer": "./src/layer.mjs",
    "./schema": "./src/schema.mjs",
    "./service": "./src/service.mjs",
    "./scope": "./src/scope.mjs",
    "./inject": "./src/inject.mjs",
    "./lifecycle": "./src/lifecycle.mjs",
    "./distiller": "./src/distiller.mjs",
    "./turn-collector": "./src/turn-collector.mjs",
    "./config": "./src/config.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/verify.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "node scripts/verify.mjs --syntax-only",
    "evidence:capabilities": "node scripts/capability-evidence.mjs"
  },
  "optionalDependencies": {
    "@node-rs/jieba": "^2.0.0"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "node": "^22.16.0 || >=24.0.0"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "bm25",
    "sqlite",
    "retrieval"
  ],
  "license": "MIT"
}
